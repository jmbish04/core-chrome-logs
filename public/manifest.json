{
  "manifest_version": 3,
  "name": "Cloudflare Workers Logs Inspector",
  "version": "1.0.0",
  "description": "Real-time Cloudflare Workers error monitor, trace inspector, and one-click agent-ready error block aggregator.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Cloudflare Workers Logs",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "sidePanel",
    "tabs",
    "contextMenus",
    "offscreen"
  ],
  "host_permissions": [
    "https://*.workers.dev/*",
    "https://api.cloudflare.com/*",
    "<all_urls>"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open Workers Logs Inspector"
    },
    "copy_all_errors": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Copy All Workers Errors for Coding Agent"
    }
  }
}
